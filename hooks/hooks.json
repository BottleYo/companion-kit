{
  "description": "安静加载轻量人格，只在人物照片回合补充身份与配方，并保护图片参考和短期回执。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_context.py\"",
            "timeout": 3,
            "additionalContextLimit": 3200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_prompt_context.py\"",
            "timeout": 2,
            "additionalContextLimit": 3800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:image_gen__imagegen|mcp__image_gen__imagegen|imagegen)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_image_guard.py\"",
            "timeout": 3,
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:image_gen__imagegen|mcp__image_gen__imagegen|imagegen)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_image_receipt.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
